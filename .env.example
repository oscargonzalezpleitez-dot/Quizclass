# QuizClass USAM Pro — Variables de entorno
# Copia este archivo como .env y completa los valores

# URL pública de la aplicación (sin / al final)
# Ejemplos:
#   https://quizclass.onrender.com
#   https://quizclass-usam-pro.web.app
#   http://localhost:5173 (desarrollo local)
VITE_APP_URL=https://TU-URL-AQUI.com

# Contraseña del panel docente (cámbiala en producción)
VITE_DOCENTE_PASS=profesor2024

